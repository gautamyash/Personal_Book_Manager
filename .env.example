# MongoDB connection string (MongoDB Atlas or local instance).
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/personal-book-manager
MONGODB_URI=

# Secret used to sign and verify JWTs. Use a long, random string in production.
JWT_SECRET=

# Optional fallback: a standard (non-SRV) mongodb:// connection string.
# Useful if your network/DNS can't resolve mongodb+srv:// (querySrv ETIMEOUT).
# Not required — only set this if you hit SRV lookup issues locally.
MONGODB_URI_STANDARD=
